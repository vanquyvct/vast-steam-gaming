#!/usr/bin/env bash
set +e

mkdir -p /config/.config/sunshine

sunshine_config=/config/.config/sunshine/sunshine.conf
touch "$sunshine_config"

while IFS='=' read -r key value; do
  if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$sunshine_config"; then
    sed -i -E "s|^[[:space:]]*${key}[[:space:]]*=.*$|${key} = ${value}|" "$sunshine_config"
  else
    printf '%s = %s\n' "$key" "$value" >> "$sunshine_config"
  fi
done <<'EOF'
origin_web_ui_allowed=wan
origin_pin_allowed=wan
address_family=ipv4
upnp=off
system_tray=disabled
EOF

/usr/bin/wrapped-steam >>/config/steam-start.log 2>&1 &

# Open Tabby automatically. If Electron/Tabby ever fails, fall back to xterm.
sleep 3
if command -v tabby >/dev/null 2>&1; then
  tabby --no-sandbox >>/config/tabby.log 2>&1 &
else
  /usr/bin/xterm -title "Vast Terminal" -geometry 120x34+20+20 >>/config/xterm.log 2>&1 &
fi

sleep 3
/usr/bin/sunshine /config/.config/sunshine/sunshine.conf >>/config/sunshine.log 2>&1 &

wait
